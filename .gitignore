# The built binary, at the repo root only — an unanchored `sdlc` would also
# match the cmd/sdlc/ package directory and quietly drop it from the repo.
/sdlc
/sdlc.exe

# Runtime state: the SQLite DB, per-job artifacts and logs. Never versioned.
/data

# The local config is a copy of sdlc.example.yaml with machine-specific paths
# (repo checkouts, agent binaries) in it. The example is the versioned one.
/sdlc.yaml

.idea

# Worktrees the orchestrator creates for in-flight jobs (.worktrees/JOB-2/ is a
# full second checkout). Anchored: only the one at the repo root.
/.worktrees/

# Per-run state the sdlc skill writes. Local to this machine's runs.
/.sdlc/

# Local Claude Code settings: machine-specific, and settings.local.json carries
# a blanket permission grant that must not follow a clone.
/.claude/settings.local.json
